# =====================================================================
#  Meir Web Development Services: environment variables
#  Copy this file to ".env" and fill in your values. Never commit .env.
# =====================================================================

# ---------- General ----------
PORT=3000
NODE_ENV=development
BUSINESS_NAME=Meir Web Development Services
SITE_URL=https://meirwebdev.com
# Your time zone (IANA name). Asia/Manila = Philippine Standard Time (PHT, UTC+8)
OWNER_TIMEZONE=Asia/Manila
# Consultation availability, in OWNER_TIMEZONE (0=Sun ... 6=Sat)
BUSINESS_DAYS=1-6
BUSINESS_HOURS=09:00-18:00
MEETING_MINUTES=30
# Max booking submissions per IP per 15 minutes
BOOKING_RATE_LIMIT=5

# ---------- Email (Nodemailer / SMTP) ----------
# Leave SMTP_HOST empty in development: emails are printed to the console.
#
# Gmail (needs 2-Step Verification + an App Password):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
#   SMTP_USER=you@gmail.com   SMTP_PASS=<16-char app password>
# Resend:   SMTP_HOST=smtp.resend.com   SMTP_PORT=465 SMTP_SECURE=true SMTP_USER=resend  SMTP_PASS=re_xxx
# SendGrid: SMTP_HOST=smtp.sendgrid.net SMTP_PORT=587 SMTP_SECURE=false SMTP_USER=apikey SMTP_PASS=SG.xxx
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# "From" shown to clients. Must be an address/domain your provider lets you send from.
MAIL_FROM="Meir Web Development Services <hello@meirwebdev.com>"
# Where new-booking alerts go (you)
OWNER_EMAIL=you@example.com
# Optional: where client replies go (defaults to OWNER_EMAIL)
REPLY_TO_EMAIL=

# ---------- Storage: pick ONE option (or none for local JSON in dev) ----------

# Option A: Google Sheets API with a service account (recommended)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Bookings
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the JSON key file, in quotes, keeping the \n sequences
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Option B: Google Apps Script web app (no Google Cloud project needed)
APPS_SCRIPT_WEBHOOK_URL=
APPS_SCRIPT_SECRET=
